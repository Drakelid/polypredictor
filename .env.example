# Copy to .env and fill in values. Never commit .env.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polypredictor
POSTGRES_USER=polypredictor
POSTGRES_PASSWORD=polypredictor_dev

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB=polypredictor
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Polymarket ---
# Public endpoints need no auth. User-specific endpoints (F7 journal auto-sync)
# require the user's own CLOB API credentials supplied per-user via the app.
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
POLYMARKET_DATA_BASE=https://data-api.polymarket.com
POLYMARKET_WSS_BASE=wss://ws-subscriptions-clob.polymarket.com

# --- External market data ---
DERIBIT_BASE=https://www.deribit.com/api/v2
CME_FEDWATCH_BASE=https://markets.api.cmegroup.com/fedwatch/v1
CME_OAUTH_TOKEN_URL=https://auth.cmegroup.com/as/token.oauth2
CME_API_ID=
CME_API_SECRET=
CME_APPLICATION_NAME=PolyPredictor
CME_APPLICATION_VENDOR=PolyPredictor
CME_APPLICATION_VERSION=0.0.1
BINANCE_BASE=https://api.binance.com
COINBASE_BASE=https://api.exchange.coinbase.com
COINGECKO_BASE=https://api.coingecko.com/api/v3

# --- Discrete-event baselines ---
# Preferred path: point to a manual/cached JSON file (see
# services/api/data/discrete_baselines.example.json).
DISCRETE_BASELINES_FILE=services/api/data/discrete_baselines.json
ENSEMBLE_REGISTRY_FILE=
CONFORMAL_REGISTRY_FILE=
RESOLUTION_RISK_MULTIPLIER_DEFAULT=1.0
FRACTIONAL_KELLY_DEFAULT=0.25
KELLY_CAP_DEFAULT=0.05
JOURNAL_DEMO_USER_EMAIL=demo@polypredictor.local
JOURNAL_DEMO_USER_NAME=Demo User
JOURNAL_DEFAULT_SIZE_USDC=100

# Legacy fallback placeholders if no JSON file is present.
FOMC_FEDWATCH_PROB=
CPI_CONSENSUS_POINT=
CPI_CONSENSUS_STDDEV=
NFP_CONSENSUS_POINT=
NFP_CONSENSUS_STDDEV=

# --- Social / news (set when enabled in M4) ---
X_API_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Ingest cadence ---
DISCOVER_INTERVAL_S=60
CLOB_TOP_N=20
CLOB_TOP_INTERVAL_S=5
CLOB_TAIL_INTERVAL_S=60
PRICES_HISTORY_BACKFILL_INTERVAL_S=600
PRICES_HISTORY_BACKFILL_BATCH_SIZE=50
PRICES_HISTORY_BACKFILL_FIDELITY=60
TRADES_SWEEPER_INTERVAL_S=30
TRADES_SWEEPER_LIMIT=200
TRADES_SWEEPER_SKIP_TOP_N=20
SMART_MONEY_REFRESH_INTERVAL_S=86400
SMART_MONEY_LEADERBOARD_LIMIT=500
SMART_MONEY_POSITIONS_LIMIT=500
FEATURE_SNAPSHOTS_INTERVAL_S=300
FEATURE_SNAPSHOTS_BATCH_SIZE=200
FEATURE_SNAPSHOTS_TRADE_DECAY_HALF_LIFE_H=6
