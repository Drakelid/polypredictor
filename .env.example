# Copy to .env and fill in values. Never commit .env.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polypredictor
POSTGRES_USER=polypredictor
POSTGRES_PASSWORD=polypredictor_dev

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB=polypredictor
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Polymarket ---
# Public endpoints need no auth. User-specific endpoints (F7 journal auto-sync)
# require the user's own CLOB API credentials supplied per-user via the app.
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
POLYMARKET_DATA_BASE=https://data-api.polymarket.com
POLYMARKET_WSS_BASE=wss://ws-subscriptions-clob.polymarket.com
# 32-byte AES key, base64url-encoded. Required before storing/decrypting
# per-user API credentials; there is no development fallback.
USER_SECRET_ENCRYPTION_KEY_B64=
AUTH_SESSION_SECRET_B64=
AUTH_SESSION_COOKIE_NAME=polypredictor_session
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_SESSION_COOKIE_SECURE=false
# Local-dev convenience: return the magic-link token in the
# /v1/auth/request-magic-link response body so you can verify the flow
# without a mailer. MUST stay false in staging/production — leaks
# session-bearing tokens to anyone who can hit the endpoint.
AUTH_MAGIC_LINK_IN_BAND=true
# Master switch for per-route auth enforcement on user-scoped routes.
# Leave false until the dashboard can drive a magic-link login flow;
# the auth dependency still validates a session cookie when present, but
# falls through to the demo user when no cookie is supplied.
AUTH_ENFORCE_USER_ROUTES=false
ADMIN_EMAILS=
ERROR_REPORTS_MAX_BODY_BYTES=65536
ERROR_REPORTS_RATE_LIMIT_PER_MINUTE=30

# --- External market data ---
DERIBIT_BASE=https://www.deribit.com/api/v2
CME_FEDWATCH_BASE=https://markets.api.cmegroup.com/fedwatch/v1
CME_OAUTH_TOKEN_URL=https://auth.cmegroup.com/as/token.oauth2
CME_API_ID=
CME_API_SECRET=
CME_APPLICATION_NAME=PolyPredictor
CME_APPLICATION_VENDOR=PolyPredictor
CME_APPLICATION_VERSION=0.0.1
BINANCE_BASE=https://api.binance.com
COINBASE_BASE=https://api.exchange.coinbase.com
COINGECKO_BASE=https://api.coingecko.com/api/v3
BLS_PUBLIC_API_BASE=https://api.bls.gov/publicAPI/v2
COINBASE_INTX_BASE=https://api.international.coinbase.com

# --- Discrete-event baselines ---
# Preferred path: point to a manual/cached JSON file (see
# services/api/data/discrete_baselines.example.json).
DISCRETE_BASELINES_FILE=services/api/data/discrete_baselines.json
ENSEMBLE_REGISTRY_FILE=
CONFORMAL_REGISTRY_FILE=
DRIFT_MONITOR_HORIZON_HOURS=24
DRIFT_MONITOR_LIMIT=1000
DRIFT_MONITOR_RESOLVED_LOOKBACK_DAYS=120
DRIFT_MONITOR_DISABLE_STREAK_DAYS=7
DRIFT_MONITOR_HISTORY_LOOKBACK_DAYS=60
FEATURE_DRIFT_CURRENT_WINDOW_DAYS=7
FEATURE_DRIFT_REFERENCE_WINDOW_DAYS=90
FEATURE_DRIFT_ALERT_THRESHOLD_PSI=0.2
FEATURE_DRIFT_MIN_SAMPLES=20
SIGNAL_ABLATION_HORIZON_HOURS=24
SIGNAL_ABLATION_LIMIT=1000
SIGNAL_ABLATION_RESOLVED_LOOKBACK_DAYS=180
SIGNAL_ABLATION_BOOTSTRAP_ITERATIONS=500
SIGNAL_ABLATION_CI_LEVEL=0.95
SIGNAL_ABLATION_MIN_SAMPLES=50
RESOLUTION_RISK_CORPUS_LIMIT=5000
RESOLUTION_RISK_CORPUS_LOOKBACK_DAYS=3650
RESOLUTION_RISK_MULTIPLIER_DEFAULT=1.0
ADVERSARIAL_FLOW_MIN_FLOW_STRENGTH=0.15
ADVERSARIAL_FLOW_SIGNAL_WINDOW_HOURS=24
ADVERSARIAL_FLOW_EXTERNAL_EVENT_WINDOW_HOURS=24
ADVERSARIAL_FLOW_FLAG_THRESHOLD=0.65
ADVERSARIAL_FLOW_BLEND_FLOOR=0.25
THIN_BOOK_TOP_LEVEL_DEPTH_THRESHOLD_USDC=1000
FRACTIONAL_KELLY_DEFAULT=0.25
KELLY_CAP_DEFAULT=0.05
EXTERNAL_DECAY_DEFAULT_HALF_LIFE_MINUTES=360
EXTERNAL_DECAY_REDDIT_HALF_LIFE_MINUTES=180
EXTERNAL_DECAY_RSS_HALF_LIFE_MINUTES=360
EXTERNAL_DECAY_X_HALF_LIFE_MINUTES=120
EXTERNAL_DECAY_DISCORD_HALF_LIFE_MINUTES=120
EXTERNAL_DECAY_MACRO_HALF_LIFE_MINUTES=1440
EXTERNAL_DECAY_ONCHAIN_HALF_LIFE_MINUTES=720
JOURNAL_DEMO_USER_EMAIL=demo@polypredictor.local
JOURNAL_DEMO_USER_NAME=Demo User
JOURNAL_DEFAULT_SIZE_USDC=100
DP_AGGREGATE_EPSILON=1.0
DP_AGGREGATE_MIN_USERS=5
DP_AGGREGATE_MIN_CALLS=20
DP_AGGREGATE_LOOKBACK_DAYS=365

# Legacy fallback placeholders if no JSON file is present.
FOMC_FEDWATCH_PROB=
CPI_CONSENSUS_POINT=
CPI_CONSENSUS_STDDEV=
NFP_CONSENSUS_POINT=
NFP_CONSENSUS_STDDEV=

# --- Social / news (set when enabled in M4) ---
X_API_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DERIBIT_IV_SURFACE_INTERVAL_S=300
DERIBIT_IV_SURFACE_CURRENCIES=BTC,ETH
BINANCE_SPOT_BASE=https://api.binance.com
COINBASE_EXCHANGE_BASE=https://api.exchange.coinbase.com
COINGECKO_BASE=https://api.coingecko.com/api/v3
SPOT_VALIDATION_INTERVAL_S=300
SPOT_VALIDATION_ASSETS=BTC,ETH,SOL
SPOT_VALIDATION_MAX_DEVIATION_BPS=50
